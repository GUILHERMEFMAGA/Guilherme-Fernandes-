# Server port
PORT=4173

# Catalog cache lifetime in milliseconds. Five minutes is a safe development default.
CATALOG_CACHE_TTL_MS=300000

# Amazon: point to YOUR server-side Amazon Creators integration.
# Never expose Amazon client secrets, Associate tags, or OAuth tokens in browser code.
# The endpoint must accept q, limit and offset and return the normalized payload in INTEGRATIONS.md.
AMAZON_CREATORS_PROXY_URL=
AMAZON_CREATORS_PROXY_TOKEN=

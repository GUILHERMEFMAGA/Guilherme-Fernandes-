# ---------------------------------------------------------------------------
# Atlas Agent - copie este arquivo para .env e preencha o que quiser usar.
# Nada aqui é obrigatorio: sem nenhuma chave o agente roda em MODO DEMO.
# ---------------------------------------------------------------------------

# ==== PROVEDOR DE IA (escolha UMA opcao gratuita, sem cartao de credito) ====
# Opcao 1 (recomendada): Google AI Studio -> https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Modelo Gemini (opcional). Se o modelo nao existir, o agente descobre outro automaticamente.
GEMINI_MODEL=gemini-2.5-flash

# Opcao 2: Groq -> https://console.groq.com/keys
GROQ_API_KEY=

# Opcao 3: OpenRouter -> https://openrouter.ai/keys (use modelos :free)
OPENROUTER_API_KEY=

# Opcao 4: qualquer endpoint compativel com OpenAI (Ollama, LM Studio, etc.)
# LLM_BASE_URL=https://api.exemplo.com/v1
# LLM_API_KEY=
# LLM_MODEL=nome-do-modelo

# Forca um provedor: gemini | groq | openrouter | demo
# LLM_PROVIDER=demo

# ==== FERRAMENTAS EXTERNAS OPCIONAIS ========================================
# Notion (plano pessoal gratuito) -> https://www.notion.so/profile/integrations
NOTION_TOKEN=
# Use UM dos dois: id do banco de dados OU id da pagina pai
NOTION_DATABASE_ID=
NOTION_PARENT_PAGE_ID=

# Webhook para automacoes (n8n, Make, Zapier, IFTTT...). Apenas URLs HTTPS.
AGENT_WEBHOOK_URL=

# Lista de hosts permitidos para a ferramenta generica http_get_json (separados por virgula).
# Exemplo: api.github.com,api.open-meteo.com,pt.wikipedia.org
ALLOWED_API_HOSTS=

# ==== SEGURANCA ============================================================
# Se definido, a interface pedira este codigo e o /api/chat exigira o header x-access-code.
AGENT_ACCESS_CODE=

# ==== SERVidor LOCAL =======================================================
PORT=3000

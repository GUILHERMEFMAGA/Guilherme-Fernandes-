# Server
PORT=4173

# Required only to call POST /api/internal/sync from an external scheduler
SYNC_SECRET=replace-with-a-long-random-secret

# Comma-separated terms used by the scheduled ingestion worker
MAVVRI_SYNC_QUERIES=ofertas,eletrônicos,casa cozinha,moda beleza,esporte,games

# Configure only approved, server-side connectors. Never expose affiliate IDs,
# private keys, OAuth tokens or proxy tokens in browser JavaScript.
MERCADOLIVRE_CATALOG_PROXY_URL=
MERCADOLIVRE_CATALOG_PROXY_TOKEN=
# Optional local-only experiment; leave false in production.
MELI_ALLOW_PUBLIC_SEARCH=false
AMAZON_CATALOG_PROXY_URL=
AMAZON_CATALOG_PROXY_TOKEN=
AMERICANAS_CATALOG_PROXY_URL=
AMERICANAS_CATALOG_PROXY_TOKEN=
SHOPEE_CATALOG_PROXY_URL=
SHOPEE_CATALOG_PROXY_TOKEN=
MAGALU_CATALOG_PROXY_URL=
MAGALU_CATALOG_PROXY_TOKEN=
SHEIN_CATALOG_PROXY_URL=
SHEIN_CATALOG_PROXY_TOKEN=
OLX_CATALOG_PROXY_URL=
OLX_CATALOG_PROXY_TOKEN=
